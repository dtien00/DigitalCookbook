# Dependencies
node_modules/

# Local test output (generated PDFs, print exports, etc.)
print_tests/


# Build output
dist/
dist-ssr/
*.local

# Environment / secrets
.env
.env.local
.env.*.local
credentials.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Working notes (kept local, not pushed)
.context/

# Claude Code local session state — ignore contents, but ship the skills/ subdir.
# (Ignoring `.claude/` outright would prevent git from descending into it,
# so the un-ignore below would silently no-op. Use `.claude/*` instead.)
.claude/*
!.claude/skills/

# Personal Claude instructions at the repo root — never publish.
# The canonical "global" note lives in ~/.claude/CLAUDE.md (outside this repo, so
# it can't be committed here anyway); this is belt-and-suspenders for the case
# where a CLAUDE.md is ever created at the repo root. A repo-local
# .claude/CLAUDE.md is already covered by `.claude/*` above.
/CLAUDE.md
/CLAUDE.local.md

# Vite dev cache (autogenerated)
.vite/
vite.config.*.timestamp-*

# Test coverage (if you add testing later)
coverage/

# TypeScript incremental build info (if you migrate later)
*.tsbuildinfo

# Supabase migration SQL queries
supabase_migration/

# Local recipe print tests
print_tests/